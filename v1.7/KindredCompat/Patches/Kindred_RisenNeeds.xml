<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/MutantDef[defName="Kindred_Risen"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/MutantDef[defName="Kindred_Risen"]/needWhitelist</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/MutantDef[defName="Kindred_Risen"]</xpath>
            <value>
              <needWhitelist />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/MutantDef[defName="Kindred_Risen"]/needWhitelist/li[text()="TM_Mana"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/MutantDef[defName="Kindred_Risen"]/needWhitelist</xpath>
            <value>
              <li>TM_Mana</li>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/MutantDef[defName="Kindred_Risen"]/needWhitelist/li[text()="TM_Stamina"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/MutantDef[defName="Kindred_Risen"]/needWhitelist</xpath>
            <value>
              <li>TM_Stamina</li>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
